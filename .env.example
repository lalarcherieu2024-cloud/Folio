# Copy to .env.local. Only NEXT_PUBLIC_* values may reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose or commit.
SUPABASE_SERVICE_ROLE_KEY=
# Gemini key for the AI brief builder (Google AI Studio). Server-only.
GEMINI_API_KEY=
# Optional model override. Default: gemini-flash-latest
GEMINI_MODEL=

# TEMPORARY dev switch: skip email confirmation for students and companies. Leave unset in production.
NEXT_PUBLIC_SKIP_EMAIL_CONFIRMATION=
# DEMO switch: let one LinkedIn/GitHub account verify several Folio logins (e.g. your company and your test
# student). Server-only. Leave unset in production.
DEMO_SHARED_SOCIAL_ACCOUNTS=

# Payments (migration 0022). PAYMENTS_MODE: "simulated" (no real money; the default in development),
# "paypal" (real money, needs the keys below) or "off". With nothing set, production stays OFF on purpose.
PAYMENTS_MODE=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Public address of the site, used for PayPal's return links in production (e.g. https://folio.app)
NEXT_PUBLIC_SITE_URL=

# Which deployment this is: "staging" shows a banner on every page. Leave empty for production.
NEXT_PUBLIC_APP_ENV=
